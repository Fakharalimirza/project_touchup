# Copy to .env.local (local dev) OR set via cPanel > Setup Node.js App > Environment Variables (production)
# Do not commit real passwords

# --- SMTP (cPanel mailbox) ---
SMTP_HOST=mail.touchup.ae
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=website-form@touchup.ae
SMTP_PASS=your-mailbox-password

# Must match SMTP_USER domain for SPF/DKIM. Display name allowed.
EMAIL_FROM_ADDRESS=Touchup Website <website-form@touchup.ae>

# Comma-separated admin recipients (both forms send to both)
ADMIN_EMAIL_BOOKING=a.galal@touchup.ae, info@touchup.ae
ADMIN_EMAIL_CONTACT=a.galal@touchup.ae, info@touchup.ae

NEXT_PUBLIC_SITE_URL=https://touchup.ae

# Optional — only if you enable AI blog generator (currently disabled, see src/ai/genkit.ts)
# GOOGLE_API_KEY=

# cPanel injects PORT automatically — do not set manually
# NODE_ENV=production
